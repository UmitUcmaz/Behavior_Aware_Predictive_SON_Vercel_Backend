/profiling/
/profiling_outputs/
/profiling_reports/
/profile_outputs/
/profile_reports/
/reports/
**/profiling/output/
**/profiling/outputs/
**/profiling/reports/
*.prof
*.pstats

# Local generated, temporary and cache directories
generated/
temp/
tmp/

