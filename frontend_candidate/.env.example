# Public API base for an independently hosted backend:
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Protected Vercel Preview alternative (set in frontend Preview environment):
# NEXT_PUBLIC_API_BASE_URL=/api/backend
# BACKEND_API_BASE_URL=https://<backend-preview>.vercel.app/api
# BACKEND_PROTECTION_BYPASS=<server-only secret; never NEXT_PUBLIC>
# BLOB_READ_WRITE_TOKEN=<server-only secret for the existing private Blob store>
# Keep Deployment Protection enabled. See PREVIEW_DEPLOYMENT.md.
